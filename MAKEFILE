tst_rast: tst_rast.o raster.o font.o
	cc68x -g tst_rast.o raster.o font.o -o tst_rast

c_example.o: c_example.c asm_example.h
	cc68x -g -c c_example.c

raster.o: raster.c raster.h
	cc68x -g -c raster.c


