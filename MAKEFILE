all: tests
tests: tst_rend tst_game tst_evnt tst_rast tst_mdl

tst_game: game.o model.o raster.o font.o bitmaps.o renderer.o asynch.o synch.o cond.o
	cc68x -g game.o model.o raster.o font.o bitmaps.o renderer.o asynch.o synch.o cond.o -o tst_game.tos

tst_evnt: tst_evnt.o model.o asynch.o synch.o cond.o bitmaps.o
	cc68x -g tst_evnt.o model.o asynch.o synch.o cond.o bitmaps.o -o tst_evnt.tos

tst_evnt.o: tst_evnt.c model.h asynch.h synch.h cond.h
	cc68x -g -c tst_evnt.c

game.o: game.c game.h model.h renderer.h raster.h events.h
	cc68x -g -c game.c

tst_rend: tst_rend.o model.o raster.o font.o bitmaps.o renderer.o asynch.o synch.o cond.o
	cc68x -g tst_rend.o model.o raster.o font.o bitmaps.o renderer.o asynch.o synch.o cond.o -o tst_rend.tos

tst_rend.o: tst_rend.c renderer.h model.h raster.h bitmaps.h
	cc68x -g -c tst_rend.c

renderer.o: renderer.c renderer.h model.h raster.h bitmaps.h
	cc68x -g -c renderer.c

asynch.o: asynch.c asynch.h model.h
	cc68x -g -c asynch.c

synch.o: synch.c synch.h cond.h model.h
	cc68x -g -c synch.c

cond.o: cond.c cond.h model.h bitmaps.h
	cc68x -g -c cond.c

bitmaps.o: bitmaps.c bitmaps.h
	cc68x -g -c bitmaps.c

tst_rast: tst_rast.o raster.o font.o
	cc68x -g tst_rast.o raster.o font.o -o tst_rast.tos

tst_rast.o: tst_rast.c
	cc68x -g -c tst_rast.c

raster.o: raster.c raster.h font.h
	cc68x -g -c raster.c

tst_mdl: tst_mdl.o model.o
	cc68x -g tst_mdl.o model.o -o tst_mdl.tos

tst_mdl.o: tst_mdl.c model.h TYPES.H
	cc68x -g -c tst_mdl.c

model.o: model.c model.h TYPES.H
	cc68x -g -c model.c

font.o: font.c font.h TYPES.H
	cc68x -g -c font.c
